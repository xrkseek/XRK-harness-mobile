<!-- Strings of the phone-control accessibility service (phone/a11y). Own file so other
     modules' string edits never collide with it. English here, Chinese in values-zh/. -->
<resources>
    <string name="phone_a11y_label">XRK Phone Control</string>
    <string name="phone_a11y_description">Works only when you ask XRK Harness to do something on your phone: it reads the text on the current screen (and takes a screenshot when needed), then taps, types and swipes as you ask. Screen content is sent to the model you chose in Settings. While it works, a bar at the top of the screen lets you pause, stop or steer at any time; actions like sending, paying or deleting ask you first. XRK Harness never fills in passwords or verification codes, never pays for you, and never changes system settings or permissions.</string>
