{
  "name": "xrk-example-usage",
  "version": "0.1.0",
  "private": true,
  "description": "XRK plugin example for the xrk-mobile app: token usage of this chat and today as a status strip and a native panel.",
  "author": "DSH-TUI (xrkseek)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node ../../../sdk/plugin-kit/bin/check.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "xrkGo": {
    "v": 1,
    "title": { "zh": "用量", "en": "Usage" },
    "icon": "chart",
    "contributes": {
      "composer.strip": [
        { "id": "today", "icon": "chart", "panel": "usage" }
      ],
      "panels": [
        { "id": "usage", "title": { "zh": "用量", "en": "Usage" }, "icon": "chart", "placement": ["session.tab", "features"] }
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
